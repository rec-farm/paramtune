# Production settings for `docker compose up`. Copy to .env (never commit it).
# For local development without Docker, use .env.local.example instead.

# Required
REDIS_PASSWORD=
# Public HTTPS origin, e.g. https://paramtune.example.com
PUBLIC_ORIGIN=

# Sign in with Handstamp (or any OpenID Connect provider). Register this app with:
#   Redirect URI:            <PUBLIC_ORIGIN>/api/auth/oauth2/callback/oidc
#   Post-logout redirect:    <PUBLIC_ORIGIN>/
#   Back-channel logout URI: <PUBLIC_ORIGIN>/api/auth/backchannel-logout
#   Client type:             server app, secret in the header (client_secret_basic)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional: empty uses the default noted in docs/DEPLOYMENT.md
OIDC_SCOPES=
OIDC_ROLES_CLAIM=
OIDC_ADMIN_GROUP=
OIDC_EDITOR_GROUP=
OIDC_PLATFORM_EDITORS=
OIDC_DISPLAY_NAME=
OIDC_CA_CERT_FILE=
# Agents act for people through farmhand, the rec.farm MCP gateway: its public origin.
GATEWAY_ISSUER=
CORS_ORIGIN=
TRUST_PROXY=false
RATE_LIMIT_API_MAX=
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_PREFIX=
