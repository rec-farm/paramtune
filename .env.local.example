# Local development example envs

# CORS allowed origin for API. Use your local dev origin or leave * for any.
CORS_ORIGIN=https://paramtune.localhost

# Redis configuration (prefer REDIS_URL if available)
# Example: redis://default:password@localhost:6379/2
REDIS_URL=

# If REDIS_URL is not set, configure host/port/password/db
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

# Better Auth configuration
# Generate a strong local value with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://paramtune.localhost
AUTH_DB_PATH=./data/auth.db

# Google OAuth credentials. Required for production Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Handstamp (or any OpenID Connect provider). Leave OIDC_ISSUER or
# OIDC_CLIENT_ID empty to hide the button. Register this app at the provider with:
#   Redirect URI:            <BETTER_AUTH_URL>/api/auth/oauth2/callback/oidc
#   Post-logout redirect:    <BETTER_AUTH_URL>/
#   Back-channel logout URI: <BETTER_AUTH_URL>/api/auth/backchannel-logout
#   Client type:             server app, secret in the header (client_secret_basic)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid profile email groups"
OIDC_ROLES_CLAIM=groups
# Members of this group get the admin role; empty promotes nobody
OIDC_ADMIN_GROUP=
OIDC_DISPLAY_NAME=Handstamp

# Development Login Credentials
DEV_USER_EMAIL=dev@paramtune.local
DEV_USER_PASSWORD=dev-password-123
DEV_USER_NAME="Dev User"
