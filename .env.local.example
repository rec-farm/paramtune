# Local development example envs

# CORS allowed origin for API. Use your local dev origin or leave * for any.
CORS_ORIGIN=http://localhost:3000

# Redis configuration (prefer REDIS_URL if available)
# Example: redis://default:password@localhost:6379/2
REDIS_URL=

# If REDIS_URL is not set, configure host/port/password/db
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

