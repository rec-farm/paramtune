{
  "name": "paramtune",
  "version": "0.1.0",
  "description": "Self-hosted platform schema and feature configuration management.",
  "license": "MIT",
  "author": "Rodrigo Espinosa Curbelo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rec-farm/paramtune.git"
  },
  "bugs": {
    "url": "https://github.com/rec-farm/paramtune/issues"
  },
  "homepage": "https://rec.farm/paramtune/",
  "scripts": {
    "monitoring:validate": "npm exec --yes --package=@rec/stillup@0.2.0 -- stillup validate --config monitoring/stillup.config.json",
    "monitoring:test": "npm exec --yes --package=@rec/stillup@0.2.0 -- stillup test --config monitoring/stillup.config.json --yes",
    "monitoring:diff": "npm exec --yes --package=@rec/stillup@0.2.0 -- stillup diff --config monitoring/stillup.config.json",
    "monitoring:apply": "npm exec --yes --package=@rec/stillup@0.2.0 -- stillup apply --config monitoring/stillup.config.json --yes",
    "dev": "portless paramtune pnpm dev:direct",
    "dev:direct": "tsx scripts/dev.ts",
    "build": "pnpm build:web && pnpm backend:build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "analyze": "pnpm build && node scripts/analyze.mjs",
    "test:e2e:ci": "node scripts/e2e.mjs",
    "build:web": "vite build && vite build --config vite.prerender.config.ts && node scripts/prerender.mjs",
    "backend:build": "cargo build --release --locked --manifest-path backend/Cargo.toml",
    "backend:test": "cargo test --locked --manifest-path backend/Cargo.toml && cargo build --locked --manifest-path backend/Cargo.toml && node scripts/test-oidc.mjs",
    "backend:check": "cargo fmt --manifest-path backend/Cargo.toml -- --check && cargo clippy --locked --manifest-path backend/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "^7.8.5",
    "tailwind-merge": "^3.7.0",
    "react-router": "^7.0.0",
    "dotenv": "^17.0.0",
    "@fontsource-variable/archivo": "^5.0.0",
    "@fontsource-variable/figtree": "^5.0.0",
    "@fontsource-variable/geist-mono": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "8.3.3",
    "vitest": "^4.1.12",
    "@vitejs/plugin-react": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "tsx": "^4.0.0",
    "typescript-eslint": "^8.0.0",
    "@eslint/js": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-jsx-a11y": "^6.0.0",
    "globals": "^16.0.0",
    "@playwright/test": "^1.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^30.1.2"
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.28",
      "sharp": ">=0.35.0",
      "brace-expansion": ">=5.0.12",
      "minimatch@3": "^10.2.5",
      "esbuild": ">=0.28.1",
      "js-yaml": "^4.3.2",
      "nanoid": "^3.3.17"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
